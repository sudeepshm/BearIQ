DATABASE_URL=postgresql+psycopg://beariq:beariq@localhost:5432/beariq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# JSON object mapping SHA256(token) to a user ID; provision tokens out of band.
API_KEY_HASHES={}
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Empty means process the upload in memory and do not retain the ZIP.
GCS_BUCKET=
MAX_UPLOAD_BYTES=20971520
MAX_UNCOMPRESSED_BYTES=104857600
MAX_CHUNKS=200
CHUNK_MESSAGES=80
CHUNK_OVERLAP=8
CHUNK_CHARACTERS=24000
